# Use the Supabase Connect > Transaction pooler URI (port 6543).
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Alternative to DATABASE_URL (do not set both):
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.PROJECT_REF
# DB_PASS=YOUR_DATABASE_PASSWORD
# DB_SSLMODE=require

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=bukti-bayar

APP_URL=https://YOUR-PROJECT.vercel.app
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
